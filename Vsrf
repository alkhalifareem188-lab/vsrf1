<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VSRF | VRFS League</title><style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #08080f;
    color: white;
}

header {
    text-align: center;
    padding: 30px 15px;
    background: linear-gradient(135deg, #641cff, #e21cff);
}

header h1 {
    margin: 0;
    font-size: 48px;
}

header p {
    margin: 8px 0 0;
    opacity: .85;
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 15px;
    background: #14141f;
}

button {
    border: none;
    border-radius: 10px;
    padding: 12px 17px;
    background: #713cff;
    color: white;
    font-weight: bold;
    cursor: pointer;
    transition: .2s;
}

button:hover {
    transform: translateY(-2px);
    opacity: .85;
}

.danger {
    background: #d93652;
}

.success {
    background: #20a66a;
}

.container {
    max-width: 1000px;
    margin: 25px auto;
    padding: 0 16px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.card {
    background: #151521;
    border: 1px solid #29293c;
    border-radius: 16px;
    padding: 22px;
    margin-bottom: 18px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
}

input {
    width: 100%;
    padding: 13px;
    margin: 7px 0 15px;
    border-radius: 9px;
    border: 1px solid #3b3b50;
    background: #0e0e17;
    color: white;
}

.ticket {
    background: #101018;
    border-left: 4px solid #783fff;
    padding: 15px;
    margin: 12px 0;
    border-radius: 8px;
}

.status {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 8px;
    background: #292940;
}

.muted {
    opacity: .7;
}

#developerPanel {
    display: none;
}

.message {
    margin-top: 10px;
    font-weight: bold;
}

.empty {
    opacity: .6;
    padding: 15px 0;
}
</style></head><body><header>
    <h1>VSRF</h1>
    <p>VRFS League</p>
</header><nav>
    <button onclick="showPage('home')">Home</button>
    <button onclick="showPage('giveaways')">Giveaways</button>
    <button onclick="showPage('tickets')">My Tickets</button>
    <button onclick="showPage('developer')">Developer Mode</button>
</nav><div class="container"><!-- HOME --><section id="home" class="page active"><div class="card">
    <h2>🏆 Welcome to VSRF</h2>
    <p>
        Welcome to the official VSRF VRFS League website.
    </p>

    <button onclick="showPage('giveaways')">
        View Giveaways
    </button>
</div>

<div class="grid">

    <div class="card">
        <h3>🎁 Giveaways</h3>
        <p>
            Won a giveaway? Claim it using your VRFS Player ID.
        </p>

        <button onclick="showPage('giveaways')">
            View Giveaways
        </button>
    </div>

    <div class="card">
        <h3>🎫 Tickets</h3>
        <p>
            Check the status of your giveaway tickets.
        </p>

        <button onclick="showPage('tickets')">
            Check Tickets
        </button>
    </div>

</div>

</section><!-- GIVEAWAYS --><section id="giveaways" class="page"><div class="card">
    <h2>🎁 Active Giveaways</h2>

    <div id="giveawayList"></div>
</div>

</section><!-- CLAIM --><section id="claim" class="page"><div class="card">

    <h2>🎫 Claim Giveaway</h2>

    <label>Giveaway</label>

    <input id="claimGiveaway" readonly>

    <label>VRFS Player ID *</label>

    <input
        id="playerID"
        placeholder="Enter your VRFS Player ID"
    >

    <label>Discord Username</label>

    <input
        id="discord"
        placeholder="@username"
    >

    <button onclick="submitTicket()" class="success">
        Submit Ticket
    </button>

    <p id="claimMessage" class="message"></p>

</div>

</section><!-- TICKETS --><section id="tickets" class="page"><div class="card">

    <h2>🔎 My Tickets</h2>

    <p>
        Enter the VRFS Player ID you used when creating your ticket.
    </p>

    <input
        id="searchID"
        placeholder="VRFS Player ID"
    >

    <button onclick="searchTickets()">
        Search
    </button>

    <div id="ticketResults"></div>

</div>

</section><!-- DEVELOPER --><section id="developer" class="page"><div id="developerLogin" class="card">

    <h2>🔐 Developer Mode</h2>

    <p>Developer access required.</p>

    <input
        id="developerPassword"
        type="password"
        placeholder="Developer passcode"
    >

    <button onclick="loginDeveloper()">
        Enter Developer Mode
    </button>

    <p id="loginMessage" class="message"></p>

</div>


<div id="developerPanel">

    <div class="card">

        <h2>🛠️ VSRF Developer Dashboard</h2>

        <p>
            Manage VSRF giveaways and player tickets.
        </p>

        <button onclick="logoutDeveloper()" class="danger">
            Log Out
        </button>

    </div>


    <!-- CREATE GIVEAWAY -->
    <div class="card">

        <h3>➕ Create Giveaway</h3>

        <input
            id="newGiveaway"
            placeholder="Giveaway name"
        >

        <button onclick="createGiveaway()" class="success">
            Create Giveaway
        </button>

        <p id="giveawayMessage" class="message"></p>

    </div>


    <!-- NOTIFICATIONS -->
    <div class="card">

        <h3>🔔 Giveaway Claim Notifications</h3>

        <div id="developerTickets"></div>

    </div>


    <!-- GIVEAWAY MANAGEMENT -->
    <div class="card">

        <h3>🎁 Manage Giveaways</h3>

        <div id="developerGiveaways"></div>

    </div>

</div>

</section></div><script>

/* ================================
   VSRF SETTINGS
================================ */

const DEVELOPER_PASSWORD = "VSRF-DEV-2026";


/* ================================
   DATABASE
================================ */

let giveaways =
    JSON.parse(localStorage.getItem("VSRF_GIVEAWAYS")) || [
        "VSRF Custom Giveaway"
    ];

let tickets =
    JSON.parse(localStorage.getItem("VSRF_TICKETS")) || [];


/* ================================
   SAVE DATABASE
================================ */

function saveDatabase() {

    localStorage.setItem(
        "VSRF_GIVEAWAYS",
        JSON.stringify(giveaways)
    );

    localStorage.setItem(
        "VSRF_TICKETS",
        JSON.stringify(tickets)
    );
}


/* ================================
   PAGE NAVIGATION
================================ */

function showPage(pageID) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    const page = document.getElementById(pageID);

    if (page) {
        page.classList.add("active");
    }

    if (pageID === "giveaways") {
        renderGiveaways();
    }

    if (pageID === "developer") {
        renderDeveloper();
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* ================================
   GIVEAWAYS
================================ */

function renderGiveaways() {

    const list = document.getElementById("giveawayList");

    list.innerHTML = "";

    if (giveaways.length === 0) {

        list.innerHTML =
            '<p class="empty">There are currently no active giveaways.</p>';

        return;
    }

    giveaways.forEach((giveaway, index) => {

        const card = document.createElement("div");

        card.className = "ticket";

        card.innerHTML = `
            <h3>🎁 ${escapeHTML(giveaway)}</h3>
            <p class="muted">
                Enter your VRFS Player ID to claim this giveaway.
            </p>

            <button onclick="openClaim(${index})">
                Claim Giveaway
            </button>
        `;

        list.appendChild(card);
    });
}


/* ================================
   OPEN CLAIM
================================ */

function openClaim(index) {

    if (!giveaways[index]) {
        alert("That giveaway no longer exists.");
        return;
    }

    document.getElementById("claimGiveaway").value =
        giveaways[index];

    document.getElementById("playerID").value = "";
    document.getElementById("discord").value = "";
    document.getElementById("claimMessage").textContent = "";

    showPage("claim");
}


/* ================================
   SUBMIT TICKET
================================ */

function submitTicket() {

    const giveaway =
        document.getElementById("claimGiveaway").value.trim();

    const playerID =
        document.getElementById("playerID").value.trim();

    const discord =
        document.getElementById("discord").value.trim();

    const message =
        document.getElementById("claimMessage");


    if (!giveaway) {

        message.textContent =
            "Please select a giveaway.";

        return;
    }


    if (!playerID) {

        message.textContent =
            "Please enter your VRFS Player ID.";

        return;
    }


    const alreadySubmitted = tickets.some(ticket =>
        ticket.playerID.toLowerCase() === playerID.toLowerCase() &&
        ticket.giveaway === giveaway
    );


    if (alreadySubmitted) {

        message.textContent =
            "You already submitted a ticket for this giveaway.";

        return;
    }


    const ticket = {

        id:
            "VSRF-" +
            Date.now().toString().slice(-8),

        giveaway: giveaway,

        playerID: playerID,

        discord: discord || "Not provided",

        status: "Pending",

        created:
            new Date().toLocaleString()

    };


    tickets.push(ticket);

    saveDatabase();


    message.textContent =
        "✅ Ticket submitted successfully!";

    document.getElementById("playerID").value = "";
    document.getElementById("discord").value = "";
}


/* ================================
   SEARCH TICKETS
================================ */

function searchTickets() {

    const searchID =
        document.getElementById("searchID").value.trim();

    const results =
        document.getElementById("ticketResults");


    results.innerHTML = "";


    if (!searchID) {

        results.innerHTML =
            '<p class="message">Enter your VRFS Player ID first.</p>';

        return;
    }


    const found =
        tickets.filter(ticket =>
            ticket.playerID.toLowerCase() ===
            searchID.toLowerCase()
        );


    if (found.length === 0) {

        results.innerHTML =
            '<p class="empty">No tickets found for that Player ID.</p>';

        return;
    }


    found.forEach(ticket => {

        const div = document.createElement("div");

        div.className = "ticket";

        div.innerHTML = `
            <h3>🎫 ${escapeHTML(ticket.giveaway)}</h3>

            <p>
                <strong>Ticket:</strong>
                ${escapeHTML(ticket.id)}
            </p>

            <p>
                <strong>Player ID:</strong>
                ${escapeHTML(ticket.playerID)}
            </p>

            <p>
                <strong>Status:</strong>
                <span class="status">
                    ${escapeHTML(ticket.status)}
                </span>
            </p>

            <p class="muted">
                Submitted: ${escapeHTML(ticket.created)}
            </p>
        `;

        results.appendChild(div);
    });
}


/* ================================
   DEVELOPER LOGIN
================================ */

function loginDeveloper() {

    const password =
        document.getElementById("developerPassword").value;

    const message =
        document.getElementById("loginMessage");


    if (password === DEVELOPER_PASSWORD) {

        localStorage.setItem(
            "VSRF_DEV_LOGGED_IN",
            "true"
        );

        document.getElementById("developerLogin").style.display =
            "none";

        document.getElementById("developerPanel").style.display =
            "block";

        message.textContent = "";

        renderDeveloper();

    } else {

        message.textContent =
            "❌ Incorrect developer passcode.";

    }
}


/* ================================
   DEVELOPER LOGOUT
================================ */

function logoutDeveloper() {

    localStorage.removeItem(
        "VSRF_DEV_LOGGED_IN"
    );

    document.getElementById("developerPanel").style.display =
        "none";

    document.getElementById("developerLogin").style.display =
        "block";

    document.getElementById("developerPassword").value = "";

    showPage("home");
}


/* ================================
   CREATE GIVEAWAY
================================ */

function createGiveaway() {

    if (!isDeveloper()) return;

    const input =
        document.getElementById("newGiveaway");

    const message =
        document.getElementById("giveawayMessage");

    const name =
        input.value.trim();


    if (!name) {

        message.textContent =
            "Enter a giveaway name.";

        return;
    }


    if (giveaways.includes(name)) {

        message.textContent =
            "That giveaway already exists.";

        return;
    }


    giveaways.push(name);

    saveDatabase();

    input.value = "";

    message.textContent =
        "✅ Giveaway created!";

    renderDeveloper();
}


/* ================================
   DELETE GIVEAWAY
================================ */

function deleteGiveaway(index) {

    if (!isDeveloper()) return;

    const name = giveaways[index];

    if (!confirm(
        `Delete "${name}"?`
    )) {
        return;
    }


    giveaways.splice(index, 1);

    saveDatabase();

    renderDeveloper();
}


/* ================================
   DEVELOPER TICKETS
================================ */

function renderDeveloperTickets() {

    const container =
        document.getElementById("developerTickets");

    container.innerHTML = "";


    if (tickets.length === 0) {

        container.innerHTML =
            '<p class="empty">No giveaway claims yet.</p>';

        return;
    }


    [...tickets].reverse().forEach((ticket, reverseIndex) => {

        const actualIndex =
            tickets.length - 1 - reverseIndex;

        const div =
            document.createElement("div");

        div.className = "ticket";

        div.innerHTML = `
            <h3>🔔 New Giveaway Claim</h3>

            <p>
                <strong>Giveaway:</strong>
                ${escapeHTML(ticket.giveaway)}
            </p>

            <p>
                <strong>Player ID:</strong>
                ${escapeHTML(ticket.playerID)}
            </p>

            <p>
                <strong>Discord:</strong>
                ${escapeHTML(ticket.discord)}
            </p>

            <p>
                <strong>Ticket ID:</strong>
                ${escapeHTML(ticket.id)}
            </p>

            <p>
                <strong>Status:</strong>
                <span class="status">
                    ${escapeHTML(ticket.status)}
                </span>
            </p>

            <p class="muted">
                ${escapeHTML(ticket.created)}
            </p>

            <button
                class="success"
                onclick="updateTicketStatus(${actualIndex}, 'Approved')">
                Approve
            </button>

            <button
                onclick="updateTicketStatus(${actualIndex}, 'Completed')">
                Complete
            </button>

            <button
                class="danger"
                onclick="updateTicketStatus(${actualIndex}, 'Rejected')">
                Reject
            </button>
        `;

        container.appendChild(div);
    });
}


/* ================================
   UPDATE TICKET
================================ */

function updateTicketStatus(index, status) {

    if (!isDeveloper()) return;

    if (!tickets[index]) return;

    tickets[index].status = status;

    saveDatabase();

    renderDeveloper();
}


/* ================================
   DEVELOPER GIVEAWAYS
================================ */

function renderDeveloperGiveaways() {

    const container =
        document.getElementById("developerGiveaways");

    container.innerHTML = "";


    if (giveaways.length === 0) {

        container.innerHTML =
            '<p class="empty">No giveaways available.</p>';

        return;
    }


    giveaways.forEach((giveaway, index) => {

        const div =
            document.createElement("div");

        div.className = "ticket";

        div.innerHTML = `
            <strong>🎁 ${escapeHTML(giveaway)}</strong>

            <button
                class="danger"
                style="float:right"
                onclick="deleteGiveaway(${index})">
                Delete
            </button>

            <div style="clear:both"></div>
        `;

        container.appendChild(div);
    });
}


/* ================================
   DEVELOPER DASHBOARD
================================ */

function renderDeveloper() {

    if (!isDeveloper()) return;

    document.getElementById("developerLogin").style.display =
        "none";

    document.getElementById("developerPanel").style.display =
        "block";

    renderDeveloperTickets();
    renderDeveloperGiveaways();
}


/* ================================
   CHECK LOGIN
================================ */

function isDeveloper() {

    return localStorage.getItem(
        "VSRF_DEV_LOGGED_IN"
    ) === "true";
}


/* ================================
   SECURITY / HTML ESCAPING
================================ */

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* ================================
   START WEBSITE
================================ */

if (isDeveloper()) {

    document.getElementById("developerLogin").style.display =
        "none";

    document.getElementById("developerPanel").style.display =
        "block";
}

renderGiveaways();

</script></body>
</html>
